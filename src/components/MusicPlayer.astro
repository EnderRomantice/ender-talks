---
import PlayerShowButton from './PlayerShowButton.astro';
---

<div id="floating-player" class="floating-player hidden" transition:persist="music-player">
    <button class="toggle-btn" id="player-toggle-btn" title="Minimize">
        <svg viewBox="0 0 24 24" width="16" height="16" class="toggle-icon">
            <path fill="currentColor" d="M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z"/>
        </svg>
    </button>
    
    <div class="player-content">
        <div class="now-playing">
            <div class="album-art">
                <img id="player-album-art" src="" alt="Album Art" style="display: none;" />
                <div class="album-art-placeholder" id="album-art-placeholder">
                    <svg viewBox="0 0 24 24" width="32" height="32">
                        <path fill="currentColor" d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/>
                    </svg>
                </div>
            </div>
            
            <div class="track-info">
                <h3 id="player-title">Select a song</h3>
                <p id="player-artist">Click to play</p>
            </div>
        </div>
        
        <div class="progress-container">
            <span class="time" id="current-time">0:00</span>
            <div class="progress-bar">
                <div class="progress-fill" id="progress-fill"></div>
            </div>
            <span class="time" id="duration">0:00</span>
        </div>
        
        <div class="controls">
            <button class="control-btn" id="prev-btn" title="Previous">
                <svg viewBox="0 0 24 24" width="24" height="24">
                    <path fill="currentColor" d="M6 6h2v12H6zm3.5 6l8.5 6V6z"/>
                </svg>
            </button>
            
            <button class="control-btn play-btn" id="play-btn" title="Play/Pause">
                <svg viewBox="0 0 24 24" width="32" height="32" id="play-icon">
                    <path fill="currentColor" d="M8 5v14l11-7z"/>
                </svg>
                <svg viewBox="0 0 24 24" width="32" height="32" id="pause-icon" style="display: none;">
                    <path fill="currentColor" d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
                </svg>
            </button>
            
            <button class="control-btn" id="next-btn" title="Next">
                <svg viewBox="0 0 24 24" width="24" height="24">
                    <path fill="currentColor" d="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z"/>
                </svg>
            </button>
        </div>
        
        <div class="volume-container">
            <button class="control-btn" id="mute-btn" title="Mute">
                <svg viewBox="0 0 24 24" width="18" height="18" id="volume-icon">
                    <path fill="currentColor" d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/>
                </svg>
            </button>
            <input type="range" id="volume-slider" min="0" max="100" value="40" />
        </div>
    </div>
</div>

<!-- Render the show button component -->
<PlayerShowButton />

<!-- Audio element with transition persistence -->
<audio id="persistent-audio" transition:persist="audio-player"></audio>

<script>
    import { getState, loadState, saveState } from '../utils/playerState';
    import type { Track } from '../utils/playerState';
    
    const PLAYER_INIT = Symbol.for('musicPlayerCoreInitialized');
    
    // Prevent duplicate initialization
    if (window[PLAYER_INIT]) {
        window.playAlbum = playAlbum;
        window.playTrack = playTrack;
        window.playTrackFromBox = playTrackFromBox;
    }
    
    window[PLAYER_INIT] = true;
    
    // DOM Elements
    const audio = document.getElementById('persistent-audio') as HTMLAudioElement;
    const floatingPlayer = document.getElementById('floating-player');
    const toggleBtn = document.getElementById('player-toggle-btn');
    const playBtn = document.getElementById('play-btn');
    const prevBtn = document.getElementById('prev-btn');
    const nextBtn = document.getElementById('next-btn');
    const muteBtn = document.getElementById('mute-btn');
    const volumeSlider = document.getElementById('volume-slider') as HTMLInputElement;
    const progressFill = document.getElementById('progress-fill');
    const currentTimeEl = document.getElementById('current-time');
    const durationEl = document.getElementById('duration');
    const playerTitle = document.getElementById('player-title');
    const playerArtist = document.getElementById('player-artist');
    const playerAlbumArt = document.getElementById('player-album-art') as HTMLImageElement;
    const albumArtPlaceholder = document.getElementById('album-art-placeholder');
    const playIcon = document.getElementById('play-icon');
    const pauseIcon = document.getElementById('pause-icon');
    const volumeIcon = document.getElementById('volume-icon');
    
    let progressInterval: number;
    let isRestoring = false;
    let isInitialized = false;
    
    // Toggle player visibility
    function toggleVisibility() {
        const s = getState();
        s.isVisible = !s.isVisible;
        updatePlayerVisibility();
    }
    
    function updatePlayerVisibility() {
        const s = getState();
        if (s.isVisible) {
            floatingPlayer?.classList.remove('hidden');
            floatingPlayer?.classList.add('visible');
        } else {
            floatingPlayer?.classList.add('hidden');
            floatingPlayer?.classList.remove('visible');
        }
        saveState(audio);
        // Update button visibility
        window.updatePlayerVisibility?.();
    }
    
    // Audio controls
    function togglePlay() {
        const s = getState();
        if (!s.currentPlaylist.length) return;
        
        s.isPlaying = !s.isPlaying;
        updatePlayButton();
        
        if (s.isPlaying) {
            startProgress();
            audio?.play().catch(err => {
                console.log('Play failed:', err);
                s.isPlaying = false;
                updatePlayButton();
            });
        } else {
            stopProgress();
            audio?.pause();
        }
        
        saveState(audio);
        // Update button state
        window.updateShowBtnState?.();
    }
    
    function updatePlayButton() {
        const s = getState();
        if (s.isPlaying) {
            playIcon?.style.setProperty('display', 'none');
            pauseIcon?.style.setProperty('display', 'block');
        } else {
            playIcon?.style.setProperty('display', 'block');
            pauseIcon?.style.setProperty('display', 'none');
        }
    }
    
    function previousTrack() {
        const s = getState();
        if (s.currentPlaylist.length > 0) {
            s.currentTrackIndex = (s.currentTrackIndex - 1 + s.currentPlaylist.length) % s.currentPlaylist.length;
            loadTrack(s.currentPlaylist[s.currentTrackIndex]);
        }
    }
    
    function nextTrack() {
        const s = getState();
        if (s.currentPlaylist.length > 0) {
            s.currentTrackIndex = (s.currentTrackIndex + 1) % s.currentPlaylist.length;
            loadTrack(s.currentPlaylist[s.currentTrackIndex]);
        }
    }
    
    // Track loading
    function loadTrack(track: Track) {
        if (!track || !audio) return;
        
        const s = getState();
        s.currentTrack = track;
        updateTrackInfo(track);
        
        audio.pause();
        ensureAudioListeners();
        
        if (track.file) {
            audio.src = track.file;
            audio.volume = (s.volume || 70) / 100;
            audio.muted = s.isMuted;
            
            if (s.isPlaying) {
                audio.play().catch(err => {
                    console.log('Auto-play prevented:', err);
                    s.isPlaying = false;
                    updatePlayButton();
                });
                startProgress();
            } else {
                s.currentTime = 0;
                updateProgressBar();
            }
        }
        
        saveState(audio);
        
        // Show player when track loaded
        if (!s.isVisible) {
            s.isVisible = true;
            updatePlayerVisibility();
        }
    }
    
    function updateTrackInfo(track: Track) {
        if (!track) return;
        
        if (playerTitle) playerTitle.textContent = track.title;
        if (playerArtist) playerArtist.textContent = track.artist || 'Unknown Artist';
        
        if (track.cover) {
            if (playerAlbumArt) {
                playerAlbumArt.src = track.cover;
                playerAlbumArt.style.display = 'block';
            }
            albumArtPlaceholder?.style.setProperty('display', 'none');
        } else {
            if (playerAlbumArt) playerAlbumArt.style.display = 'none';
            albumArtPlaceholder?.style.setProperty('display', 'flex');
        }
    }
    
    // Progress handling
    function startProgress() {
        stopProgress();
        progressInterval = window.setInterval(() => {
            if (audio) {
                getState().currentTime = audio.currentTime;
                updateProgressBar();
            }
        }, 100);
    }
    
    function stopProgress() {
        clearInterval(progressInterval);
    }
    
    function updateProgressBar() {
        const s = getState();
        const duration = audio?.duration || s.duration || 0;
        const current = audio?.currentTime || s.currentTime || 0;
        const progress = duration > 0 ? (current / duration) * 100 : 0;
        
        if (progressFill) progressFill.style.width = `${progress}%`;
        if (currentTimeEl) currentTimeEl.textContent = formatTime(current);
        if (durationEl) durationEl.textContent = formatTime(duration);
    }
    
    function formatTime(seconds: number): string {
        if (isNaN(seconds)) return '0:00';
        const mins = Math.floor(seconds / 60);
        const secs = Math.floor(seconds % 60);
        return `${mins}:${secs.toString().padStart(2, '0')}`;
    }
    
    // Volume control
    function toggleMute() {
        const s = getState();
        s.isMuted = !s.isMuted;
        if (audio) audio.muted = s.isMuted;
        updateVolumeIcon();
        saveState(audio);
    }
    
    function updateVolumeIcon() {
        const s = getState();
        if (!volumeIcon) return;
        
        if (s.isMuted || volumeSlider.value === '0') {
            volumeIcon.innerHTML = '<path fill="currentColor" d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"/>';
        } else if (parseInt(volumeSlider.value) < 50) {
            volumeIcon.innerHTML = '<path fill="currentColor" d="M18.5 12c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM5 9v6h4l5 5V4L9 9H5z"/>';
        } else {
            volumeIcon.innerHTML = '<path fill="currentColor" d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/>';
        }
    }
    
    // Audio event listeners
    function ensureAudioListeners() {
        if (audio?.__listenersBound) return;
        
        audio?.addEventListener('ended', nextTrack);
        audio?.addEventListener('loadedmetadata', () => {
            if (!isRestoring) {
                getState().duration = audio.duration;
                updateProgressBar();
                saveState(audio);
            }
        });
        
        (audio as any).__listenersBound = true;
    }
    
    // State restoration
    function restoreState() {
        const s = getState();
        if (!s.currentTrack || !s.currentPlaylist.length || !audio) return;
        
        isRestoring = true;
        updatePlayerVisibility();
        
        if (s.volume !== undefined && volumeSlider) {
            volumeSlider.value = s.volume.toString();
        }
        
        updateTrackInfo(s.currentTrack);
        ensureAudioListeners();
        
        if (s.currentTrack.file) {
            audio.src = s.currentTrack.file;
            audio.volume = (s.volume || 70) / 100;
            audio.muted = s.isMuted;
            updatePlayButton();
            updateVolumeIcon();
            
            if (s.currentTime > 0) {
                audio.currentTime = s.currentTime;
            }
            
            if (s.isPlaying) {
                audio.play().then(() => startProgress()).catch(err => {
                    console.log('Auto-play prevented:', err);
                    s.isPlaying = false;
                    updatePlayButton();
                });
            }
        }
        
        isRestoring = false;
    }
    
    // Global functions
    function playAlbum(album: any, startIndex = 0) {
        console.log('[MusicPlayer] playAlbum:', album?.title);
        if (!album?.songs?.length) return;
        
        const s = getState();
        s.currentPlaylist = album.songs.map((song: any, index: number) => ({
            ...song,
            album: album.title,
            artist: album.artist,
            cover: album.cover
        }));
        s.currentTrackIndex = startIndex;
        s.isPlaying = true;
        loadTrack(s.currentPlaylist[startIndex]);
        updatePlayButton();
        saveState(audio);
        window.updateShowBtnState?.();
    }
    
    function playTrack(track: Track) {
        const s = getState();
        s.currentPlaylist = [track];
        s.currentTrackIndex = 0;
        s.isPlaying = true;
        loadTrack(track);
        updatePlayButton();
        saveState(audio);
        window.updateShowBtnState?.();
    }
    
    function playTrackFromBox(albumId: string, songTitle: string) {
        const albums = (window as any).__MUSIC_ALBUMS__;
        if (!albums) return;
        
        const album = albums.find((a: any) => a.id === albumId);
        if (!album) return;
        
        const song = album.songs.find((s: any) => s.title === songTitle);
        if (!song) return;
        
        playTrack({
            ...song,
            album: album.title,
            artist: album.artist,
            cover: album.cover
        });
    }
    
    // Event bindings
    function bindEvents() {
        toggleBtn?.addEventListener('click', () => {
            toggleVisibility();
        });
        
        playBtn?.addEventListener('click', togglePlay);
        prevBtn?.addEventListener('click', () => { previousTrack(); saveState(audio); });
        nextBtn?.addEventListener('click', () => { nextTrack(); saveState(audio); });
        muteBtn?.addEventListener('click', toggleMute);
        
        volumeSlider?.addEventListener('input', (e) => {
            const newVolume = parseInt((e.target as HTMLInputElement).value);
            getState().volume = newVolume;
            if (audio) audio.volume = newVolume / 100;
            updateVolumeIcon();
            saveState(audio);
        });
        
        document.querySelector('.progress-bar')?.addEventListener('click', (e) => {
            if (!audio) return;
            const rect = (e.currentTarget as HTMLElement).getBoundingClientRect();
            const clickPosition = (e.clientX - rect.left) / rect.width;
            audio.currentTime = clickPosition * audio.duration;
            getState().currentTime = audio.currentTime;
            updateProgressBar();
            saveState(audio);
        });
        
        // Listen for toggle event from button component
        window.addEventListener('player-toggle-visibility', () => {
            toggleVisibility();
        });
    }
    
    // Initialize
    function init() {
        if (isInitialized) return;
        
        loadState();
        updatePlayerVisibility();
        restoreState();
        updateVolumeIcon();
        bindEvents();
        
        isInitialized = true;
        
        // Expose global functions
        window.playAlbum = playAlbum;
        window.playTrack = playTrack;
        window.playTrackFromBox = playTrackFromBox;
    }
    
    // Page lifecycle
    window.addEventListener('beforeunload', () => saveState(audio));
    document.addEventListener('astro:before-swap', () => saveState(audio));
    document.addEventListener('astro:after-swap', () => {
        window.playAlbum = playAlbum;
        window.playTrack = playTrack;
        window.playTrackFromBox = playTrackFromBox;
    });
    
    // Start
    init();
</script>

<style>
    /* Player container styles */
    .floating-player {
        position: fixed;
        top: 100px;
        right: 20px;
        width: 360px;
        background: white;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
        z-index: 1000;
        transition: transform 0.3s ease, opacity 0.3s ease;
    }
    
    .floating-player.hidden {
        transform: translateX(calc(100% + 30px));
        opacity: 0;
        pointer-events: none;
    }
    
    .floating-player.visible {
        transform: translateX(0);
        opacity: 1;
    }
    
    .toggle-btn {
        position: absolute;
        top: 8px;
        right: 8px;
        width: 24px;
        height: 24px;
        background: transparent;
        color: rgb(var(--gray));
        border: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: color 0.2s ease;
        z-index: 10;
        opacity: 0.6;
    }
    
    .toggle-btn:hover {
        color: rgb(var(--black));
        opacity: 1;
    }
    
    .player-content {
        padding: 1.2em;
    }
    
    /* Now playing section */
    .now-playing {
        display: flex;
        align-items: center;
        gap: 1em;
        margin-bottom: 1em;
        padding-right: 30px;
    }
    
    .album-art {
        position: relative;
        width: 60px;
        height: 60px;
        flex-shrink: 0;
    }
    
    .album-art img {
        width: 100%;
        height: 100%;
        border-radius: 8px;
        object-fit: cover;
    }
    
    .album-art-placeholder {
        width: 100%;
        height: 100%;
        border-radius: 8px;
        background: rgb(var(--gray-light));
        display: flex;
        align-items: center;
        justify-content: center;
        color: rgb(var(--gray));
    }
    
    .track-info {
        flex: 1;
        min-width: 0;
    }
    
    .track-info h3 {
        margin: 0 0 0.2em 0;
        font-size: 1em;
        color: rgb(var(--black));
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    
    .track-info p {
        margin: 0;
        color: rgb(var(--gray));
        font-size: 0.85em;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    
    /* Progress bar */
    .progress-container {
        display: flex;
        align-items: center;
        gap: 0.5em;
        margin-bottom: 0.8em;
    }
    
    .time {
        font-size: 0.75em;
        color: rgb(var(--gray));
        min-width: 35px;
        text-align: center;
    }
    
    .progress-bar {
        flex: 1;
        height: 4px;
        background: rgb(var(--gray-light));
        border-radius: 2px;
        cursor: pointer;
        position: relative;
        overflow: hidden;
    }
    
    .progress-fill {
        height: 100%;
        background: var(--accent);
        border-radius: 2px;
        transition: width 0.1s linear;
        width: 0%;
    }
    
    /* Controls */
    .controls {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 1em;
        margin-bottom: 0.8em;
    }
    
    .control-btn {
        background: none;
        border: none;
        cursor: pointer;
        color: rgb(var(--gray-dark));
        transition: color 0.2s ease, transform 0.2s ease;
        padding: 0.3em;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    
    .control-btn:hover {
        color: var(--accent);
        transform: scale(1.1);
    }
    
    .play-btn {
        background: var(--accent);
        color: white !important;
        border-radius: 50%;
        width: 44px;
        height: 44px;
    }
    
    .play-btn:hover {
        background: var(--accent-dark);
    }
    
    /* Volume */
    .volume-container {
        display: flex;
        align-items: center;
        gap: 0.5em;
        justify-content: center;
        color: rgb(var(--gray));
    }
    
    .volume-container input[type="range"] {
        width: 100px;
        height: 4px;
        -webkit-appearance: none;
        appearance: none;
        background: rgb(var(--gray-light));
        border-radius: 2px;
        outline: none;
    }
    
    .volume-container input[type="range"]::-webkit-slider-thumb {
        -webkit-appearance: none;
        appearance: none;
        width: 12px;
        height: 12px;
        background: var(--accent);
        border-radius: 50%;
        cursor: pointer;
    }
    
    .volume-container input[type="range"]::-moz-range-thumb {
        width: 12px;
        height: 12px;
        background: var(--accent);
        border-radius: 50%;
        cursor: pointer;
        border: none;
    }
    
    /* Responsive */
    @media (max-width: 720px) {
        .floating-player {
            left: 0;
            right: 0;
            top: auto;
            bottom: 0;
            width: 100%;
            border-radius: 16px 16px 0 0;
        }
        
        .floating-player.hidden {
            transform: translateY(100%);
        }
        
        .player-content {
            padding: 1em;
        }
        
        .now-playing {
            padding-right: 35px;
        }
    }
</style>
