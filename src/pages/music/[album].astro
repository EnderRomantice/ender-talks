---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { albums } from "../../data/albums";

export function getStaticPaths() {
    return albums.map((album) => ({
        params: { album: album.id },
        props: { album },
    }));
}

const { album } = Astro.props;

const head = {
    title: `${album.title} - Ender Talks Music`,
    description: `${album.title} by ${album.artist}`,
};

const isLocked = !!album.lock;
const lockKey = album.lock?.key || '';
const lockHint = album.lock?.hint || '';
const albumId = album.id;
---

<BaseLayout title={head.title} description={head.description}>
    <main class="album-detail-container" data-album-id={albumId} data-lock-key={lockKey} data-lock-hint={lockHint} data-is-locked={isLocked}>
        {isLocked && (
            <div id="album-lock-overlay" class="album-lock-overlay">
                <div class="album-lock-content">
                    <svg class="album-lock-icon" viewBox="0 0 24 24" width="64" height="64">
                        <path fill="currentColor" d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/>
                    </svg>
                    <h2 class="album-lock-title">此专辑已锁定</h2>
                    <p class="album-lock-hint">{lockHint || '需要密钥才能访问'}</p>
                    <input 
                        type="password" 
                        id="album-unlock-input" 
                        class="album-unlock-input" 
                        placeholder="请输入密钥..."
                        autocomplete="off"
                    />
                    <div class="album-lock-buttons">
                        <a href="/music" class="album-lock-btn album-lock-btn-back">返回专辑列表</a>
                        <button id="album-unlock-btn" class="album-lock-btn album-lock-btn-unlock">解锁</button>
                    </div>
                    <p id="album-unlock-error" class="album-unlock-error"></p>
                </div>
            </div>
        )}
        
        <div class="album-header">
            <div class="album-cover-large">
                <img src={album.cover} alt={album.title} class={isLocked ? 'blurred' : ''} />
            </div>

            <div class="album-meta">
                <h1>{album.title}</h1>

                {
                    album.description && (
                        <div class="album-description">
                            <p>{album.description}</p>
                        </div>
                    )
                }

                <div class="album-actions">
                    <button class="play-all-btn" id="play-all-btn">
                        <svg viewBox="0 0 24 24" width="24" height="24">
                            <path fill="currentColor" d="M8 5v14l11-7z"></path>
                        </svg>
                        Play All
                    </button>

                    <a href="/music" class="back-link"> Back to Albums </a>
                </div>
            </div>
        </div>

        <section class="playlist-section">
            <h2>Playlist</h2>

            <div class="song-list" data-album={JSON.stringify(album)}>
                <div class="song-list-header">
                    <span class="song-number"> </span>
                    <span class="song-title-header">Title</span>
                </div>

                {
                    album.songs.map((song, index) => (
                        <div
                            class="song-item"
                            data-index={index}
                            data-title={song.title}
                        >
                            <span class="song-number">
                                <span class="number">{index + 1}</span>
                                <button
                                    class="play-song-btn"
                                    data-index={index}
                                >
                                    <svg
                                        viewBox="0 0 24 24"
                                        width="20"
                                        height="20"
                                    >
                                        <path
                                            fill="currentColor"
                                            d="M8 5v14l11-7z"
                                        />
                                    </svg>
                                </button>
                            </span>
                            <span class="song-title">
                                {song.title}
                                {song.isRecommended && (
                                    <span
                                        class="recommended-star"
                                        title="Recommended"
                                    >
                                        <svg
                                            viewBox="0 0 24 24"
                                            width="16"
                                            height="16"
                                        >
                                            <path
                                                fill="currentColor"
                                                d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"
                                            />
                                        </svg>
                                    </span>
                                )}
                            </span>
                        </div>
                    ))
                }
            </div>
        </section>
    </main>

    <script>
        // 从 DOM 获取当前页面的 album 数据
        function getAlbumFromDOM() {
            const songList = document.querySelector('.song-list');
            if (!songList) return null;
            
            try {
                const albumData = songList.dataset.album;
                if (!albumData) return null;
                return JSON.parse(albumData);
            } catch (e) {
                console.error('[Album Page] Failed to parse album data:', e);
                return null;
            }
        }

        // 检查专辑是否被锁定
        // 专辑锁定解锁逻辑
        const UNLOCKED_ALBUMS_KEY = 'unlockedAlbums';
        
        function getUnlockedAlbums() {
            try {
                const data = localStorage.getItem(UNLOCKED_ALBUMS_KEY);
                return data ? JSON.parse(data) : [];
            } catch {
                return [];
            }
        }
        
        function saveUnlockedAlbum(albumId) {
            const unlocked = getUnlockedAlbums();
            if (!unlocked.includes(albumId)) {
                unlocked.push(albumId);
                localStorage.setItem(UNLOCKED_ALBUMS_KEY, JSON.stringify(unlocked));
            }
        }
        
        function isAlbumUnlocked(albumId) {
            return getUnlockedAlbums().includes(albumId);
        }
        
        function isAlbumLocked() {
            const container = document.querySelector('.album-detail-container');
            if (!container) return false;
            
            const isLocked = container.dataset.isLocked === 'true';
            const albumId = container.dataset.albumId;
            
            if (!isLocked || !albumId) return false;
            
            // 检查是否已解锁
            return !isAlbumUnlocked(albumId);
        }

        function handlePlayAll() {
            if (isAlbumLocked()) {
                // 显示解锁弹窗
                const lockOverlay = document.getElementById('album-lock-overlay');
                const unlockInput = document.getElementById('album-unlock-input');
                if (lockOverlay) {
                    lockOverlay.classList.remove('hidden');
                    unlockInput?.focus();
                }
                return;
            }
            
            const album = getAlbumFromDOM();
            console.log('[Album Page] Play All clicked, album:', album?.title);
            if (window.playAlbum && album) {
                window.playAlbum(album, 0);
            } else {
                console.error('[Album Page] window.playAlbum not found or no album data!');
            }
        }

        function playSongAtIndex(index) {
            if (isAlbumLocked()) {
                // 显示解锁弹窗
                const lockOverlay = document.getElementById('album-lock-overlay');
                const unlockInput = document.getElementById('album-unlock-input');
                if (lockOverlay) {
                    lockOverlay.classList.remove('hidden');
                    unlockInput?.focus();
                }
                return;
            }
            
            const album = getAlbumFromDOM();
            console.log('[Album Page] Play song at index:', index, 'song:', album?.songs?.[index]?.title);
            if (window.playAlbum && album) {
                window.playAlbum(album, index);
            } else {
                console.error('[Album Page] window.playAlbum not found or no album data!');
            }
        }

        // 使用事件委托到 document，只绑定一次
        if (!window.__ALBUM_PAGE_EVENTS_BOUND__) {
            window.__ALBUM_PAGE_EVENTS_BOUND__ = true;
            
            document.addEventListener('click', (e) => {
                // Play All 按钮
                const playAllBtn = e.target.closest('#play-all-btn');
                if (playAllBtn) {
                    e.preventDefault();
                    handlePlayAll();
                    return;
                }
                
                // 播放按钮
                const playBtn = e.target.closest('.play-song-btn');
                if (playBtn) {
                    e.preventDefault();
                    e.stopPropagation();
                    const index = parseInt(playBtn.dataset.index);
                    playSongAtIndex(index);
                    return;
                }
                
                // 歌曲项（排除播放按钮）
                const songItem = e.target.closest('.song-item');
                if (songItem && !e.target.closest('.play-song-btn')) {
                    e.preventDefault();
                    const index = parseInt(songItem.dataset.index);
                    playSongAtIndex(index);
                    return;
                }
            });
            
            console.log('[Album Page] Event delegation bound to document');
        }
        
        console.log('[Album Page] Script initialized, album:', getAlbumFromDOM()?.title);
        
        // 检查专辑锁定状态
        function initAlbumLock() {
            const container = document.querySelector('.album-detail-container');
            if (!container) return;
            
            const isLocked = container.dataset.isLocked === 'true';
            const albumId = container.dataset.albumId;
            
            if (!isLocked || !albumId) return;
            
            const lockOverlay = document.getElementById('album-lock-overlay');
            const coverImg = document.querySelector('.album-cover-large img');
            
            // 检查是否已解锁，更新UI状态
            if (isAlbumUnlocked(albumId)) {
                if (lockOverlay) lockOverlay.classList.add('hidden');
                if (coverImg) {
                    coverImg.classList.remove('blurred');
                    coverImg.classList.add('unlocked');
                }
            } else {
                // 锁定状态，显示遮罩
                if (lockOverlay) lockOverlay.classList.remove('hidden');
                if (coverImg) {
                    coverImg.classList.add('blurred');
                    coverImg.classList.remove('unlocked');
                }
            }
        }
        
        // 初始化解锁按钮事件（只绑定一次）
        function initUnlockButton() {
            if (window.__ALBUM_UNLOCK_INIT__) return;
            window.__ALBUM_UNLOCK_INIT__ = true;
            
            const container = document.querySelector('.album-detail-container');
            if (!container) return;
            
            const albumId = container.dataset.albumId;
            const lockKey = container.dataset.lockKey;
            
            const lockOverlay = document.getElementById('album-lock-overlay');
            const unlockInput = document.getElementById('album-unlock-input');
            const unlockBtn = document.getElementById('album-unlock-btn');
            const unlockError = document.getElementById('album-unlock-error');
            const coverImg = document.querySelector('.album-cover-large img');
            
            // 解锁按钮事件
            unlockBtn?.addEventListener('click', () => {
                if (!unlockInput || !lockKey) return;
                
                const inputKey = unlockInput.value.trim();
                if (inputKey === lockKey) {
                    saveUnlockedAlbum(albumId);
                    if (lockOverlay) lockOverlay.classList.add('hidden');
                    if (coverImg) {
                        coverImg.classList.remove('blurred');
                        coverImg.classList.add('unlocked');
                    }
                } else {
                    if (unlockError) unlockError.textContent = '密钥错误，请重试';
                    if (unlockInput) {
                        unlockInput.value = '';
                        unlockInput.focus();
                    }
                }
            });
            
            // 回车解锁
            unlockInput?.addEventListener('keypress', (e) => {
                if (e.key === 'Enter') {
                    unlockBtn?.click();
                }
            });
        }
        
        // 初始化锁定检查
        initAlbumLock();
        initUnlockButton();
        
        // 支持 Astro View Transitions
        document.addEventListener('astro:page-load', () => {
            initAlbumLock();
            initUnlockButton();
        });
    </script>
</BaseLayout>

<style>
    .album-detail-container {
        max-width: 1000px;
        margin: 0 auto;
        padding: 2em 1em;
    }

    .album-header {
        display: flex;
        gap: 3em;
        margin-bottom: 3em;
        align-items: flex-start;
    }

    .album-cover-large {
        flex-shrink: 0;
        width: 280px;
        height: 280px;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 12px rgba(var(--gray), 20%);
    }

    .album-cover-large img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 0;
    }

    .album-meta {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 0.5em;
    }

    .album-type {
        font-size: 0.85em;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: var(--accent);
        font-weight: 600;
    }

    .album-meta h1 {
        font-size: 3em;
        margin: 0;
        line-height: 1.1;
    }

    .album-artist-large {
        font-size: 1.3em;
        color: rgb(var(--gray));
        margin: 0;
    }

    .album-stats {
        color: rgb(var(--gray));
        font-size: 0.9em;
        margin: 0.5em 0 1em 0;
    }

    .album-description {
        margin: 0.5em 0 1em 0;
        padding: 1em;
        background: rgba(var(--gray-light), 0.5);
        border-radius: 8px;
        font-size: 0.875rem;
        color: rgb(var(--gray));
        font-style: italic;
    }

    .album-description p {
        margin: 0;
        color: rgb(var(--gray-dark));
        font-size: 0.95em;
        line-height: 1.6;
        white-space: pre-wrap;
    }

    .album-actions {
        display: flex;
        gap: 1em;
        align-items: center;
    }

    .play-all-btn {
        display: flex;
        align-items: center;
        gap: 0.5em;
        background: var(--accent);
        color: white;
        border: none;
        padding: 0.8em 1.5em;
        border-radius: 500px;
        font-size: 1em;
        font-family: inherit;
        cursor: pointer;
        transition:
            background 0.2s ease,
            transform 0.2s ease;
    }

    .play-all-btn:hover {
        background: var(--accent-dark);
        transform: scale(1.02);
    }

    .back-link {
        display: flex;
        align-items: center;
        gap: 0.3em;
        color: rgb(var(--gray));
        text-decoration: none;
        font-size: 0.95em;
        transition: color 0.2s ease;
    }

    .back-link:hover {
        color: var(--accent);
    }

    .playlist-section {
        margin-top: 2em;
    }

    .playlist-section h2 {
        margin-bottom: 1em;
        font-size: 1.5em;
    }

    .song-list {
        background: white;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(var(--gray), 15%);
    }

    .song-list-header {
        display: grid;
        grid-template-columns: 60px 1fr;
        padding: 1em 1.5em;
        background: rgb(var(--gray-light));
        font-weight: 600;
        font-size: 0.85em;
        color: rgb(var(--gray));
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .song-item {
        display: grid;
        grid-template-columns: 60px 1fr;
        padding: 1em 1.5em;
        align-items: center;
        border-bottom: 1px solid rgb(var(--gray-light));
        cursor: pointer;
        transition: background 0.2s ease;
    }

    .song-item:last-child {
        border-bottom: none;
    }

    .song-item:hover {
        background: rgba(var(--gray-light), 0.5);
    }

    .song-item:hover .number {
        display: none;
    }

    .song-item:hover .play-song-btn {
        display: flex;
    }

    .song-number {
        display: flex;
        align-items: center;
        justify-content: center;
        color: rgb(var(--gray));
        font-size: 0.95em;
    }

    .play-song-btn {
        display: none;
        background: var(--accent);
        color: white;
        border: none;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: transform 0.2s ease;
    }

    .play-song-btn:hover {
        transform: scale(1.1);
    }

    .song-title {
        font-weight: 500;
        color: rgb(var(--black));
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        padding-right: 1em;
        display: flex;
        align-items: center;
        gap: 0.5em;
    }

    .recommended-star {
        color: #ffc107;
        flex-shrink: 0;
        display: inline-flex;
        align-items: center;
    }

    @media (max-width: 720px) {
        html,
        body {
            overflow-x: hidden;
        }

        .album-detail-container {
            padding: 1em 0.8em;
            width: 100%;
            max-width: 100vw;
            box-sizing: border-box;
        }

        .album-header {
            flex-direction: column;
            align-items: center;
            text-align: center;
            gap: 1.2em;
            margin-bottom: 2em;
        }

        .album-cover-large {
            width: 180px;
            height: 180px;
            border-radius: 8px;
        }

        .album-meta h1 {
            font-size: 1.6em;
            line-height: 1.2;
        }

        .album-description {
            padding: 0.8em;
            margin: 0.3em 0 0.8em 0;
        }

        .album-description p {
            font-size: 0.9em;
            line-height: 1.5;
        }

        .album-actions {
            flex-direction: column;
            width: 100%;
            gap: 0.8em;
        }

        .play-all-btn {
            width: 100%;
            justify-content: center;
            padding: 0.7em 1.2em;
            font-size: 0.95em;
        }

        .back-link {
            font-size: 0.9em;
            justify-content: center;
        }

        .playlist-section {
            margin-top: 1.5em;
        }

        .playlist-section h2 {
            font-size: 1.3em;
            margin-bottom: 0.8em;
        }

        .song-list {
            border-radius: 8px;
        }

        .song-list-header {
            display: none;
        }

        .song-item {
            grid-template-columns: 45px 1fr;
            padding: 0.9em 1em;
            min-height: 56px;
        }

        .song-title {
            font-size: 0.95em;
            padding-right: 0.5em;
        }

        .play-song-btn {
            display: flex;
            width: 32px;
            height: 32px;
        }

        .number {
            display: none;
        }

        .recommended-star svg {
            width: 14px;
            height: 14px;
        }
    }

    @media (max-width: 480px) {
        .album-detail-container {
            padding: 0.8em 0.6em;
        }

        .album-cover-large {
            width: 140px;
            height: 140px;
        }

        .album-meta h1 {
            font-size: 1.3em;
        }

        .song-item {
            padding: 0.75em 0.8em;
            min-height: 50px;
        }

        .song-title {
            font-size: 0.85em;
        }

        .play-song-btn {
            width: 28px;
            height: 28px;
        }
    }

    /* 专辑锁定遮罩 */
    .album-lock-overlay {
        position: fixed;
        inset: 0;
        background: rgba(255, 255, 255, 0.95);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        backdrop-filter: blur(10px);
    }

    .album-lock-overlay.hidden {
        display: none;
    }

    .album-lock-content {
        background: white;
        border-radius: 20px;
        padding: 3em;
        width: 90%;
        max-width: 400px;
        box-shadow: 0 20px 80px rgba(0, 0, 0, 0.15);
        text-align: center;
        animation: lockSlideIn 0.4s ease;
    }

    @keyframes lockSlideIn {
        from {
            opacity: 0;
            transform: translateY(-30px) scale(0.95);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    .album-lock-icon {
        color: var(--accent);
        margin-bottom: 1em;
    }

    .album-lock-title {
        margin: 0 0 0.5em 0;
        font-size: 1.5em;
        color: rgb(var(--black));
    }

    .album-lock-hint {
        color: rgb(var(--gray));
        margin: 0 0 1.5em 0;
        font-size: 1em;
    }

    .album-unlock-input {
        width: 100%;
        padding: 1em;
        border: 2px solid rgb(var(--gray-light));
        border-radius: 12px;
        font-size: 1em;
        font-family: inherit;
        box-sizing: border-box;
        transition: all 0.2s ease;
        margin-bottom: 1.5em;
        text-align: center;
    }

    .album-unlock-input:focus {
        outline: none;
        border-color: var(--accent);
        box-shadow: 0 0 0 4px rgba(35, 55, 255, 0.1);
    }

    .album-lock-buttons {
        display: flex;
        gap: 1em;
    }

    .album-lock-btn {
        flex: 1;
        padding: 1em 1.2em;
        border: none;
        border-radius: 12px;
        font-size: 1em;
        font-family: inherit;
        cursor: pointer;
        transition: all 0.2s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .album-lock-btn-back {
        background: rgb(var(--gray-light));
        color: rgb(var(--gray));
    }

    .album-lock-btn-back:hover {
        background: rgb(var(--gray));
        color: white;
    }

    .album-lock-btn-unlock {
        background: var(--accent);
        color: white;
    }

    .album-lock-btn-unlock:hover {
        background: var(--accent-dark);
        transform: translateY(-2px);
    }

    .album-unlock-error {
        color: #e74c3c;
        text-align: center;
        margin: 1em 0 0 0;
        font-size: 0.9em;
        min-height: 1.4em;
    }

    .album-cover-large img.blurred {
        filter: blur(15px);
        transition: filter 0.5s ease;
    }

    .album-cover-large img.unlocked {
        filter: blur(0);
    }

    @media (max-width: 720px) {
        .album-lock-content {
            padding: 2em 1.5em;
        }

        .album-lock-title {
            font-size: 1.3em;
        }

        .album-lock-hint {
            font-size: 0.9em;
        }

        .album-unlock-input {
            padding: 0.8em;
        }

        .album-lock-buttons {
            flex-direction: column;
        }

        .album-lock-btn {
            padding: 0.9em;
        }
    }
</style>
