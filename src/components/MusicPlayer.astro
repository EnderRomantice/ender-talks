---
---

<div id="floating-player" class="floating-player hidden" transition:persist="music-player">
    <button class="toggle-btn" id="player-toggle-btn" title="Minimize">
        <svg viewBox="0 0 24 24" width="16" height="16" class="toggle-icon">
            <path fill="currentColor" d="M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z"/>
        </svg>
    </button>
    
    <div class="player-content">
        <div class="now-playing">
            <div class="album-art">
                <img id="player-album-art" src="" alt="Album Art" style="display: none;" />
                <div class="album-art-placeholder" id="album-art-placeholder">
                    <svg viewBox="0 0 24 24" width="32" height="32">
                        <path fill="currentColor" d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/>
                    </svg>
                </div>
            </div>
            
            <div class="track-info">
                <h3 id="player-title">Select a song</h3>
                <p id="player-artist">Click to play</p>
            </div>
        </div>
        
        <div class="progress-container">
            <span class="time" id="current-time">0:00</span>
            <div class="progress-bar">
                <div class="progress-fill" id="progress-fill"></div>
            </div>
            <span class="time" id="duration">0:00</span>
        </div>
        
        <div class="controls">
            <button class="control-btn" id="prev-btn" title="Previous">
                <svg viewBox="0 0 24 24" width="24" height="24">
                    <path fill="currentColor" d="M6 6h2v12H6zm3.5 6l8.5 6V6z"/>
                </svg>
            </button>
            
            <button class="control-btn play-btn" id="play-btn" title="Play/Pause">
                <svg viewBox="0 0 24 24" width="32" height="32" id="play-icon">
                    <path fill="currentColor" d="M8 5v14l11-7z"/>
                </svg>
                <svg viewBox="0 0 24 24" width="32" height="32" id="pause-icon" style="display: none;">
                    <path fill="currentColor" d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
                </svg>
            </button>
            
            <button class="control-btn" id="next-btn" title="Next">
                <svg viewBox="0 0 24 24" width="24" height="24">
                    <path fill="currentColor" d="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z"/>
                </svg>
            </button>
        </div>
        
        <div class="volume-container">
            <button class="control-btn" id="mute-btn" title="Mute">
                <svg viewBox="0 0 24 24" width="18" height="18" id="volume-icon">
                    <path fill="currentColor" d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/>
                </svg>
            </button>
            <input type="range" id="volume-slider" min="0" max="100" value="40" />
        </div>
    </div>
</div>

<button id="player-show-btn" class="player-show-btn hidden" title="Show Player" transition:persist="player-show-btn">
    <svg class="default-icon" viewBox="0 0 24 24" width="24" height="24">
        <path fill="currentColor" d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/>
    </svg>
    <img class="album-cover" src="" alt="Album Cover" style="display: none;">
</button>

<!-- 使用真实的 audio DOM 元素，这样 transition:persist 可以保持播放状态 -->
<audio id="persistent-audio" transition:persist="audio-player"></audio>

<script>
    // 使用 Symbol 创建全局唯一标识符，确保脚本只初始化一次
    const PLAYER_INITIALIZED = Symbol.for('musicPlayerInitialized');
    
    // 如果已经初始化过，跳过重复初始化（View Transitions 保持组件时）
    if (window[PLAYER_INITIALIZED]) {
        // 只需重新暴露全局函数供新页面使用（这些函数会操作 window.__PLAYER_STATE__）
        window.playAlbum = playAlbum;
        window.playTrack = playTrack;
        window.playTrackFromBox = playTrackFromBox;
    }
    
    window[PLAYER_INITIALIZED] = true;
    
    const STORAGE_KEY = 'musicPlayerState';
    
    // 将状态挂载到 window，所有函数共享同一个状态对象
    if (!window.__PLAYER_STATE__) {
        window.__PLAYER_STATE__ = {
            isPlaying: false,
            currentTrackIndex: 0,
            currentPlaylist: [],
            isMuted: false,
            isVisible: false,
            currentTime: 0,
            duration: 0,
            currentTrack: null,
            volume: 10
        };
    }
    
    // 辅助函数：获取当前状态（总是从 window 读取）
    function getState() {
        return window.__PLAYER_STATE__;
    }
    
    let progressInterval;
    let isRestoring = false;
    let isInitialized = false;
    
    // 获取持久化的 DOM audio 元素（transition:persist 会保持这个元素）
    const audioElement = document.getElementById('persistent-audio');
    
    const floatingPlayer = document.getElementById('floating-player');
    const playerShowBtn = document.getElementById('player-show-btn');
    const toggleBtn = document.getElementById('player-toggle-btn');
    const playBtn = document.getElementById('play-btn');
    const prevBtn = document.getElementById('prev-btn');
    const nextBtn = document.getElementById('next-btn');
    const muteBtn = document.getElementById('mute-btn');
    const playIcon = document.getElementById('play-icon');
    const pauseIcon = document.getElementById('pause-icon');
    const volumeIcon = document.getElementById('volume-icon');
    const progressFill = document.getElementById('progress-fill');
    const currentTimeEl = document.getElementById('current-time');
    const durationEl = document.getElementById('duration');
    const playerTitle = document.getElementById('player-title');
    const playerArtist = document.getElementById('player-artist');
    const playerAlbumArt = document.getElementById('player-album-art');
    const albumArtPlaceholder = document.getElementById('album-art-placeholder');
    const volumeSlider = document.getElementById('volume-slider');
    const toggleIcon = toggleBtn?.querySelector('.toggle-icon path');
    const playerShowBtnCover = playerShowBtn?.querySelector('.album-cover');
    const playerShowBtnIcon = playerShowBtn?.querySelector('.default-icon');
    
    // Cover color cache
    const COLOR_CACHE_KEY = 'musicPlayerCoverColors';
    const COLOR_CACHE_VERSION = 'v2'; // 缓存版本号，算法更新时递增
    let coverColorCache = {};
    
    // Load color cache from localStorage
    function loadColorCache() {
        try {
            const cached = localStorage.getItem(COLOR_CACHE_KEY);
            const version = localStorage.getItem(COLOR_CACHE_KEY + '_version');
            
            // Clear cache if version mismatch (algorithm updated)
            if (cached && version === COLOR_CACHE_VERSION) {
                coverColorCache = JSON.parse(cached);
            } else {
                // Clear old cache
                coverColorCache = {};
                localStorage.removeItem(COLOR_CACHE_KEY);
                localStorage.setItem(COLOR_CACHE_KEY + '_version', COLOR_CACHE_VERSION);
            }
        } catch (e) {
            console.error('Failed to load color cache:', e);
        }
    }
    
    // Save color cache to localStorage
    function saveColorCache() {
        try {
            localStorage.setItem(COLOR_CACHE_KEY, JSON.stringify(coverColorCache));
        } catch (e) {
            console.error('Failed to save color cache:', e);
        }
    }
    
    // Extract dominant color from image using canvas
    async function extractCoverColor(imageUrl) {
        // Check cache first
        if (coverColorCache[imageUrl]) {
            return coverColorCache[imageUrl];
        }
        
        return new Promise((resolve) => {
            const img = new Image();
            img.crossOrigin = 'anonymous';
            
            img.onload = () => {
                try {
                    const canvas = document.createElement('canvas');
                    const ctx = canvas.getContext('2d');
                    
                    // Use larger size for better accuracy
                    canvas.width = 100;
                    canvas.height = 100;
                    
                    ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
                    
                    // Sample center region (40% of image) - usually the main artwork
                    const centerSize = 40;
                    const startX = (canvas.width - centerSize) / 2;
                    const startY = (canvas.height - centerSize) / 2;
                    
                    const imageData = ctx.getImageData(startX, startY, centerSize, centerSize);
                    const data = imageData.data;
                    
                    // Use weighted average with emphasis on vibrant colors
                    let r = 0, g = 0, b = 0, totalWeight = 0;
                    
                    for (let i = 0; i < data.length; i += 4) {
                        const pixelR = data[i];
                        const pixelG = data[i + 1];
                        const pixelB = data[i + 2];
                        
                        // Calculate saturation (vibrancy)
                        const max = Math.max(pixelR, pixelG, pixelB);
                        const min = Math.min(pixelR, pixelG, pixelB);
                        const saturation = max === 0 ? 0 : (max - min) / max;
                        
                        // Weight by saturation - vibrant colors get higher weight
                        const weight = 0.3 + saturation * 0.7;
                        
                        r += pixelR * weight;
                        g += pixelG * weight;
                        b += pixelB * weight;
                        totalWeight += weight;
                    }
                    
                    if (totalWeight > 0) {
                        r = Math.round(r / totalWeight);
                        g = Math.round(g / totalWeight);
                        b = Math.round(b / totalWeight);
                    } else {
                        r = 35; g = 55; b = 255;
                    }
                    
                    const color = `${r}, ${g}, ${b}`;
                    console.log('[MusicPlayer] Extracted color:', color, 'from', imageUrl);
                    
                    // Cache the result
                    coverColorCache[imageUrl] = color;
                    saveColorCache();
                    
                    resolve(color);
                } catch (e) {
                    console.error('Failed to extract color:', e);
                    resolve('35, 55, 255');
                }
            };
            
            img.onerror = () => {
                resolve('35, 55, 255');
            };
            
            img.src = imageUrl;
        });
    }
    
    // Update pulse animation color
    async function updatePulseColor(imageUrl) {
        if (!imageUrl) {
            // Use default color
            updatePulseStyle('35, 55, 255');
            return;
        }
        
        const color = await extractCoverColor(imageUrl);
        updatePulseStyle(color);
    }
    
    // Update CSS custom property for pulse color
    function updatePulseStyle(color) {
        console.log('[MusicPlayer] Updating pulse color to:', color);
        if (playerShowBtn) {
            playerShowBtn.style.setProperty('--pulse-color', color);
            console.log('[MusicPlayer] Pulse color set on button');
        } else {
            console.error('[MusicPlayer] playerShowBtn not found!');
        }
    }
    
    // Load color cache on startup
    loadColorCache();
    
    // Save state to localStorage
    function saveState() {
        try {
            const s = getState();
            localStorage.setItem(STORAGE_KEY, JSON.stringify({
                isPlaying: s.isPlaying,
                currentTrackIndex: s.currentTrackIndex,
                currentPlaylist: s.currentPlaylist,
                isMuted: s.isMuted,
                isVisible: s.isVisible,
                currentTime: audioElement ? audioElement.currentTime : s.currentTime,
                duration: audioElement ? audioElement.duration : s.duration,
                currentTrack: s.currentTrack,
                volume: s.volume,
                savedAt: Date.now()
            }));
        } catch (e) {
            console.error('Failed to save player state:', e);
        }
    }
    
    // Load state from localStorage
    function loadState() {
        try {
            const saved = localStorage.getItem(STORAGE_KEY);
            if (saved) {
                const parsed = JSON.parse(saved);
                // Only restore if saved within last 30 minutes
                if (Date.now() - (parsed.savedAt || 0) < 30 * 60 * 1000) {
                    Object.assign(getState(), parsed);
                    return true;
                }
            }
        } catch (e) {
            console.error('Failed to load player state:', e);
        }
        return false;
    }
    
    // Restore player state
    function restoreState() {
        const s = getState();
        if (!s.currentTrack || !s.currentPlaylist.length || !audioElement) return;
        
        isRestoring = true;
        
        // Restore visibility
        updatePlayerVisibility();
        
        // Restore volume
        if (s.volume !== undefined) {
            volumeSlider.value = s.volume;
        }
        
        // Restore track info
        updateTrackInfo(s.currentTrack);
        
        // Use existing DOM audio element (persisted by View Transitions)
        if (s.currentTrack.file) {
            ensureAudioListeners();
            
            audioElement.src = s.currentTrack.file;
            audioElement.volume = (s.volume || 70) / 100;
            audioElement.muted = s.isMuted;
            
            // Update button state
            updatePlayButton();
            updateVolumeIcon();
            
            if (s.currentTime > 0) {
                audioElement.currentTime = s.currentTime;
            }
            
            // If was playing, start playing
            if (s.isPlaying) {
                audioElement.play().then(() => {
                    startProgress();
                }).catch(err => {
                    console.log('Auto-play prevented:', err);
                    s.isPlaying = false;
                    updatePlayButton();
                });
            }
        }
        
        isRestoring = false;
    }
    
    function onLoadedMetadata() {
        if (audioElement && !isRestoring) {
            getState().duration = audioElement.duration;
            updateProgressBar();
            saveState();
        }
    }
    
    function ensureAudioListeners() {
        if (!audioElement || audioElement.__listenersBound) return;
        
        audioElement.addEventListener('ended', onTrackEnded);
        audioElement.addEventListener('loadedmetadata', onLoadedMetadata);
        audioElement.__listenersBound = true;
    }
    
    function updatePlayerVisibility() {
        if (getState().isVisible) {
            floatingPlayer.classList.remove('hidden');
            floatingPlayer.classList.add('visible');
            playerShowBtn.classList.add('hidden');
            if (toggleIcon) {
                toggleIcon.setAttribute('d', 'M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z');
            }
        } else {
            floatingPlayer.classList.add('hidden');
            floatingPlayer.classList.remove('visible');
            playerShowBtn.classList.remove('hidden');
        }
        saveState();
    }
    
    function toggleVisibility() {
        getState().isVisible = !getState().isVisible;
        updatePlayerVisibility();
    }
    
    function togglePlay() {
        const s = getState();
        if (!s.currentPlaylist.length) return;
        
        s.isPlaying = !s.isPlaying;
        updatePlayButton();
        
        if (s.isPlaying) {
            startProgress();
            if (audioElement) {
                audioElement.play().catch(err => {
                    console.log('Play failed:', err);
                    s.isPlaying = false;
                    updatePlayButton();
                });
            }
        } else {
            stopProgress();
            if (audioElement) {
                audioElement.pause();
            }
        }
        
        saveState();
    }
    
    function updatePlayButton() {
        if (getState().isPlaying) {
            playIcon.style.display = 'none';
            pauseIcon.style.display = 'block';
        } else {
            playIcon.style.display = 'block';
            pauseIcon.style.display = 'none';
        }
        // 同步更新展开按钮状态
        updateShowBtnState();
    }
    
    function updateVolumeIcon() {
        if (getState().isMuted || volumeSlider.value == 0) {
            volumeIcon.innerHTML = '<path fill="currentColor" d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"/>';
        } else if (volumeSlider.value < 50) {
            volumeIcon.innerHTML = '<path fill="currentColor" d="M18.5 12c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM5 9v6h4l5 5V4L9 9H5z"/>';
        } else {
            volumeIcon.innerHTML = '<path fill="currentColor" d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/>';
        }
    }
    
    function toggleMute() {
        const s = getState();
        s.isMuted = !s.isMuted;
        if (audioElement) {
            audioElement.muted = s.isMuted;
        }
        updateVolumeIcon();
        saveState();
    }
    
    function startProgress() {
      
        stopProgress();
        
        progressInterval = setInterval(() => {
            if (audioElement) {
                getState().currentTime = audioElement.currentTime;
                updateProgressBar();
            }
        }, 100);
    }
    
    function stopProgress() {
        clearInterval(progressInterval);
    }
    
    function updateProgressBar() {
        const s = getState();
        const duration = audioElement?.duration || s.duration || 0;
        const current = audioElement?.currentTime || s.currentTime || 0;
        const progress = duration > 0 ? (current / duration) * 100 : 0;
        
        progressFill.style.width = `${progress}%`;
        currentTimeEl.textContent = formatTime(current);
        durationEl.textContent = formatTime(duration);
    }
    
    function formatTime(seconds) {
        if (isNaN(seconds)) return '0:00';
        const mins = Math.floor(seconds / 60);
        const secs = Math.floor(seconds % 60);
        return `${mins}:${secs.toString().padStart(2, '0')}`;
    }
    
    function previousTrack() {
        const s = getState();
        if (s.currentPlaylist.length > 0) {
            s.currentTrackIndex = (s.currentTrackIndex - 1 + s.currentPlaylist.length) % s.currentPlaylist.length;
            loadTrack(s.currentPlaylist[s.currentTrackIndex]);
        }
    }
    
    function nextTrack() {
        const s = getState();
        if (s.currentPlaylist.length > 0) {
            s.currentTrackIndex = (s.currentTrackIndex + 1) % s.currentPlaylist.length;
            loadTrack(s.currentPlaylist[s.currentTrackIndex]);
        }
    }
    
    function updateTrackInfo(track) {
        if (!track) return;
        
        playerTitle.textContent = track.title;
        playerArtist.textContent = track.artist || 'Unknown Artist';
        
        if (track.cover) {
            playerAlbumArt.src = track.cover;
            playerAlbumArt.style.display = 'block';
            if (albumArtPlaceholder) albumArtPlaceholder.style.display = 'none';
            // 同时更新展开按钮的封面
            if (playerShowBtnCover) {
                playerShowBtnCover.src = track.cover;
            }
            // 提取并应用封面颜色到脉冲动画
            updatePulseColor(track.cover);
        } else {
            playerAlbumArt.style.display = 'none';
            if (albumArtPlaceholder) albumArtPlaceholder.style.display = 'flex';
            if (playerShowBtnCover) {
                playerShowBtnCover.src = '';
            }
            // Reset to default color
            updatePulseColor(null);
        }
    }
    
    function updateShowBtnState() {
        const s = getState();
        const hasTrack = s.currentTrack && s.currentTrack.cover;
        
        if (hasTrack) {
            // 有歌曲时显示封面
            playerShowBtn?.classList.add('playing');
            if (playerShowBtnCover) playerShowBtnCover.style.display = 'block';
            if (playerShowBtnIcon) playerShowBtnIcon.style.display = 'none';
            
            // 只有播放时才有脉冲效果
            if (s.isPlaying) {
                playerShowBtn?.classList.add('pulse');
            } else {
                playerShowBtn?.classList.remove('pulse');
            }
        } else {
            // 没有歌曲时显示默认图标
            playerShowBtn?.classList.remove('playing');
            playerShowBtn?.classList.remove('pulse');
            if (playerShowBtnCover) playerShowBtnCover.style.display = 'none';
            if (playerShowBtnIcon) playerShowBtnIcon.style.display = 'block';
        }
    }
    
    function loadTrack(track) {
        if (!track || !audioElement) return;
        
        const s = getState();
        s.currentTrack = track;
        updateTrackInfo(track);
        
        // 使用现有的 DOM audio 元素（由 transition:persist 保持）
        // 暂停当前播放
        audioElement.pause();
        
        // 确保事件监听器只绑定一次
        ensureAudioListeners();
        
        if (track.file) {
            audioElement.src = track.file;
            audioElement.volume = (s.volume || 70) / 100;
            audioElement.muted = s.isMuted;
            
            if (s.isPlaying) {
                audioElement.play().catch(err => {
                    console.log('Auto-play prevented:', err);
                    s.isPlaying = false;
                    updatePlayButton();
                });
                startProgress();
            } else {
                s.currentTime = 0;
                updateProgressBar();
            }
        }
        
        saveState();
        
        // Show player when track loaded
        if (!s.isVisible) {
            s.isVisible = true;
            updatePlayerVisibility();
        }
    }
    
    function onTrackEnded() {
        nextTrack();
    }
    
    // Global function to play album
    function playAlbum(album, startIndex = 0) {
        console.log('[MusicPlayer] playAlbum called:', album?.title, 'startIndex:', startIndex);
        const s = getState();
        
        if (!album || !album.songs || !album.songs.length) {
            console.error('[MusicPlayer] Invalid album data:', album);
            return;
        }
        
        s.currentPlaylist = album.songs.map((song, index) => ({
            ...song,
            album: album.title,
            artist: album.artist,
            cover: album.cover
        }));
        s.currentTrackIndex = startIndex;
        s.isPlaying = true;
        console.log('[MusicPlayer] Playlist updated, loading track:', s.currentPlaylist[startIndex]?.title);
        loadTrack(s.currentPlaylist[s.currentTrackIndex]);
        updatePlayButton();
        saveState();
    }
    
    // Global function to play single track
    function playTrack(track) {
        const s = getState();
        s.currentPlaylist = [track];
        s.currentTrackIndex = 0;
        s.isPlaying = true;
        loadTrack(track);
        updatePlayButton();
        saveState();
    }
    
    // Global function for MusicBox component - play single song from album
    function playTrackFromBox(albumId, songTitle) {
       
        const albums = window.__MUSIC_ALBUMS__;
        
        if (!albums) {
            console.error('Music albums data not available. Make sure MusicBox component is rendered on the page.');
            return;
        }
        
        const album = albums.find(a => a.id === albumId);
        if (!album) {
            console.error(`Album "${albumId}" not found`);
            return;
        }

        const song = album.songs.find(s => s.title === songTitle);
        if (!song) {
            console.error(`Song "${songTitle}" not found in album "${albumId}"`);
            return;
        }

        
        const track = {
            ...song,
            album: album.title,
            artist: album.artist,
            cover: album.cover
        };

        
        playTrack(track);
    }

   
    function processMusicBoxQueue() {
        if (window.musicBoxClickQueue && window.musicBoxClickQueue.length > 0) {
            console.log('MusicPlayer: 处理队列中的', window.musicBoxClickQueue.length, '个请求');
            while (window.musicBoxClickQueue.length > 0) {
                const { albumId, songTitle } = window.musicBoxClickQueue.shift();
                window.playTrackFromBox(albumId, songTitle);
            }
        }
    }
    
    // Expose to window for external access
    window.playAlbum = playAlbum;
    window.playTrack = playTrack;
    
    // Event listeners - only bind once
    if (!isInitialized) {
        toggleBtn?.addEventListener('click', toggleVisibility);
        playerShowBtn?.addEventListener('click', toggleVisibility);
        playBtn?.addEventListener('click', togglePlay);
        prevBtn?.addEventListener('click', () => { previousTrack(); saveState(); });
        nextBtn?.addEventListener('click', () => { nextTrack(); saveState(); });
        muteBtn?.addEventListener('click', toggleMute);
        
        volumeSlider?.addEventListener('input', (e) => {
            const newVolume = parseInt(e.target.value);
            getState().volume = newVolume;
            if (audioElement) {
                audioElement.volume = newVolume / 100;
            }
            updateVolumeIcon();
            saveState();
        });
        
        // Click on progress bar to seek
        document.querySelector('.progress-bar')?.addEventListener('click', (e) => {
            if (!audioElement) return;
            const rect = e.currentTarget.getBoundingClientRect();
            const clickPosition = (e.clientX - rect.left) / rect.width;
            audioElement.currentTime = clickPosition * audioElement.duration;
            getState().currentTime = audioElement.currentTime;
            updateProgressBar();
            saveState();
        });
    }
    
    // Save state before page unload
    window.addEventListener('beforeunload', saveState);
    
    // Handle View Transitions page swaps - save state before swap
    document.addEventListener('astro:before-swap', () => {
        saveState();
    });
    
    // After View Transitions swap - expose global functions (they will use window.__PLAYER_STATE__)
    document.addEventListener('astro:after-swap', () => {
        console.log('[MusicPlayer] astro:after-swap - re-exposing global functions');
        window.playAlbum = playAlbum;
        window.playTrack = playTrack;
        window.playTrackFromBox = playTrackFromBox;
        console.log('[MusicPlayer] Global functions exposed, playAlbum:', typeof window.playAlbum);
        
        // 重新同步 UI 状态（展开按钮是新 DOM，需要更新其显示状态）
        updatePlayerVisibility();
        updateShowBtnState();
        
        // 重新应用当前歌曲的脉冲颜色
        const s = getState();
        if (s.currentTrack?.cover) {
            updatePulseColor(s.currentTrack.cover);
        }
    });

    // Initialize
    if (!isInitialized) {
        loadState();
        updatePlayerVisibility(); // 确保 UI 状态与 isVisible 一致
        restoreState();
        updateVolumeIcon();
        updateShowBtnState(); // 初始化展开按钮状态
        isInitialized = true;

        // 暴露全局函数供外部调用
        window.playAlbum = playAlbum;
        window.playTrack = playTrack;
        window.playTrackFromBox = playTrackFromBox;

        processMusicBoxQueue();
    }
</script>

