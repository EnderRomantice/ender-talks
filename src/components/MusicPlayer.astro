---
import PlayerShowButton from './PlayerShowButton.astro';
---

<div id="music-app-root" class="music-app-root hidden" transition:persist="music-player">
    <div class="player-content">
        <button class="close-btn" id="player-close-btn" title="Close">
            <svg viewBox="0 0 24 24" width="16" height="16">
                <path fill="currentColor" d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
            </svg>
        </button>
        <div class="now-playing">
            <div class="album-art">
                <img id="player-album-art" src="" alt="Album Art" style="display: none;" />
                <div class="album-art-placeholder" id="album-art-placeholder">
                    <svg viewBox="0 0 24 24" width="32" height="32">
                        <path fill="currentColor" d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/>
                    </svg>
                </div>
            </div>
            
            <div class="track-info">
                <h3 id="player-title">Select a song</h3>
                <p id="player-artist">Click to play</p>
            </div>
        </div>
        
        <div class="progress-container">
            <span class="time" id="current-time">0:00</span>
            <div class="progress-bar">
                <div class="progress-fill" id="progress-fill"></div>
            </div>
            <span class="time" id="duration">0:00</span>
        </div>
        
        <div class="controls">
            <button class="control-btn" id="prev-btn" title="Previous">
                <svg viewBox="0 0 24 24" width="24" height="24">
                    <path fill="currentColor" d="M6 6h2v12H6zm3.5 6l8.5 6V6z"/>
                </svg>
            </button>
            
            <button class="control-btn play-btn" id="play-btn" title="Play/Pause">
                <svg viewBox="0 0 24 24" width="32" height="32" id="play-icon">
                    <path fill="currentColor" d="M8 5v14l11-7z"/>
                </svg>
                <svg viewBox="0 0 24 24" width="32" height="32" id="pause-icon" style="display: none;">
                    <path fill="currentColor" d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
                </svg>
            </button>
            
            <button class="control-btn" id="next-btn" title="Next">
                <svg viewBox="0 0 24 24" width="24" height="24">
                    <path fill="currentColor" d="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z"/>
                </svg>
            </button>
        </div>
        
        <div class="bottom-controls">
            <div class="volume-container">
                <button class="control-btn" id="mute-btn" title="Mute">
                    <svg viewBox="0 0 24 24" width="18" height="18" id="volume-icon">
                        <path fill="currentColor" d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/>
                    </svg>
                </button>
                <input type="range" id="volume-slider" min="0" max="100" value="40" />
            </div>
            
            <button class="control-btn queue-toggle-btn" id="queue-toggle-btn" title="Playlist Queue">
                <svg viewBox="0 0 24 24" width="18" height="18">
                    <path fill="currentColor" d="M15 6H3v2h12V6zm0 4H3v2h12v-2zM3 16h8v-2H3v2zM17 6v8.18c-.31-.11-.65-.18-1-.18-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3V8h3V6h-5z"/>
                </svg>
            </button>
        </div>
        
        <div class="queue-drawer hidden" id="queue-drawer">
            <div class="drawer-content">
                <div class="queue-header">
                    <h4>Up Next</h4>
                    <button id="clear-queue-btn">Clear</button>
                </div>
                <ul class="queue-list" id="queue-list">
                    <!-- Items injected by JS -->
                </ul>
            </div>
        </div>
    </div>
</div>

<PlayerShowButton />

<audio id="persistent-audio" transition:persist="audio-player"></audio>

<script>
    import { getPlayerController } from '../utils/playerController';
    import { loadState, saveState, type Track } from '../utils/playerState';
    
    // DOM Elements cache
    const elements = {
        player: null as HTMLElement | null,
        closeBtn: null as HTMLElement | null,
        playBtn: null as HTMLElement | null,
        prevBtn: null as HTMLElement | null,
        nextBtn: null as HTMLElement | null,
        muteBtn: null as HTMLElement | null,
        volumeSlider: null as HTMLInputElement | null,
        progressFill: null as HTMLElement | null,
        currentTime: null as HTMLElement | null,
        duration: null as HTMLElement | null,
        title: null as HTMLElement | null,
        artist: null as HTMLElement | null,
        albumArt: null as HTMLImageElement | null,
        placeholder: null as HTMLElement | null,
        playIcon: null as HTMLElement | null,
        pauseIcon: null as HTMLElement | null,
        volumeIcon: null as HTMLElement | null,
        audio: null as HTMLAudioElement | null,
        queueToggleBtn: null as HTMLElement | null,
        queueDrawer: null as HTMLElement | null,
        queueList: null as HTMLElement | null,
        clearQueueBtn: null as HTMLElement | null,
    };
    
    // Get controller
    const controller = getPlayerController();
    
    // Get all elements from DOM
    function getElements() {
        elements.player = document.getElementById('music-app-root');
        elements.closeBtn = document.getElementById('player-close-btn');
        elements.playBtn = document.getElementById('play-btn');
        elements.prevBtn = document.getElementById('prev-btn');
        elements.nextBtn = document.getElementById('next-btn');
        elements.muteBtn = document.getElementById('mute-btn');
        elements.volumeSlider = document.getElementById('volume-slider') as HTMLInputElement;
        elements.progressFill = document.getElementById('progress-fill');
        elements.currentTime = document.getElementById('current-time');
        elements.duration = document.getElementById('duration');
        elements.title = document.getElementById('player-title');
        elements.artist = document.getElementById('player-artist');
        elements.albumArt = document.getElementById('player-album-art') as HTMLImageElement;
        elements.placeholder = document.getElementById('album-art-placeholder');
        elements.playIcon = document.getElementById('play-icon');
        elements.pauseIcon = document.getElementById('pause-icon');
        elements.volumeIcon = document.getElementById('volume-icon');
        elements.audio = document.getElementById('persistent-audio') as HTMLAudioElement;
        elements.queueToggleBtn = document.getElementById('queue-toggle-btn');
        elements.queueDrawer = document.getElementById('queue-drawer');
        elements.queueList = document.getElementById('queue-list');
        elements.clearQueueBtn = document.getElementById('clear-queue-btn');
    }
    
    // Update UI based on state
    function updateVisibility(isVisible: boolean) {
        if (!elements.player) return;
        
        if (isVisible) {
            elements.player.classList.remove('hidden');
            elements.player.classList.add('visible');
        } else {
            elements.player.classList.add('hidden');
            elements.player.classList.remove('visible');
        }
    }
    
    function updateTrackInfo(track: Track | null) {
        // Redrer queue to update playing status
        renderQueue(controller.getState().currentPlaylist);

        if (!track) {
            if (elements.title) elements.title.textContent = 'Select a song';
            if (elements.artist) elements.artist.textContent = 'Click to play';
            if (elements.albumArt) elements.albumArt.style.display = 'none';
            if (elements.placeholder) elements.placeholder.style.display = 'flex';
            return;
        }
        
        if (elements.title) {
            elements.title.textContent = track.title.replace('[正式版]', '*');
        }
        if (elements.artist) elements.artist.textContent = track.artist || 'Unknown Artist';
        
        if (track.cover) {
            if (elements.albumArt) {
                elements.albumArt.src = track.cover;
                elements.albumArt.style.display = 'block';
            }
            if (elements.placeholder) elements.placeholder.style.display = 'none';
        } else {
            if (elements.albumArt) elements.albumArt.style.display = 'none';
            if (elements.placeholder) elements.placeholder.style.display = 'flex';
        }
    }

    function renderQueue(playlist: Track[]) {
        if (!elements.queueList) return;
        
        const state = controller.getState();
        const currentIndex = state.currentTrackIndex;

        if (playlist.length === 0) {
            elements.queueList.innerHTML = '<li class="queue-empty">Your queue is empty</li>';
            return;
        }

        elements.queueList.innerHTML = playlist.map((track, index) => {
            const isActive = index === currentIndex;
            const noLyrics = !track.hasLyrics;
            const displayTitle = track.title.replace('[正式版]', '*');
            
            return `
                <li class="queue-item ${isActive ? 'active' : ''} ${noLyrics ? 'no-lyrics' : ''}" data-index="${index}">
                    <div class="queue-info">
                        <div class="queue-thumbnail">
                            ${track.cover ? `<img src="${track.cover}" alt="" />` : `<div class="queue-thumbnail-placeholder"></div>`}
                            ${isActive ? `
                                <div class="playing-overlay">
                                    <div class="playing-indicator">
                                        <span></span><span></span><span></span>
                                    </div>
                                </div>
                            ` : ''}
                        </div>
                        <div class="queue-text">
                            <span class="queue-title">${displayTitle}</span>
                            <span class="queue-artist">${track.artist || 'Unknown'}</span>
                        </div>
                    </div>
                    
                    <div class="queue-actions">
                        <button class="action-btn remove-btn" data-index="${index}" title="Remove">
                            <svg viewBox="0 0 24 24" width="14" height="14">
                                <path fill="currentColor" d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
                            </svg>
                        </button>
                    </div>
                </li>
            `;
        }).join('');

        // Bind clicks to items
        elements.queueList.querySelectorAll('.queue-item').forEach(item => {
            item.addEventListener('click', (e) => {
                if ((e.target as HTMLElement).closest('.action-btn')) return;
                const index = parseInt((item as HTMLElement).dataset.index || '0');
                controller.playFromQueue(index);
            });
        });

        // Bind remove buttons
        elements.queueList.querySelectorAll('.remove-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.stopPropagation();
                const index = parseInt((btn as HTMLElement).dataset.index || '0');
                controller.removeFromQueue(index);
            });
        });
    }
    
    function updatePlayButton(isPlaying: boolean) {
        if (isPlaying) {
            elements.playIcon?.style.setProperty('display', 'none');
            elements.pauseIcon?.style.setProperty('display', 'block');
        } else {
            elements.playIcon?.style.setProperty('display', 'block');
            elements.pauseIcon?.style.setProperty('display', 'none');
        }
    }
    
    function updateVolumeIcon() {
        if (!elements.volumeIcon || !elements.volumeSlider) return;
        
        const state = controller.getState();
        const volume = parseInt(elements.volumeSlider.value);
        
        if (state.isMuted || volume === 0) {
            elements.volumeIcon.innerHTML = '<path fill="currentColor" d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"/>';
        } else if (volume < 50) {
            elements.volumeIcon.innerHTML = '<path fill="currentColor" d="M18.5 12c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM5 9v6h4l5 5V4L9 9H5z"/>';
        } else {
            elements.volumeIcon.innerHTML = '<path fill="currentColor" d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/>';
        }
    }
    
    function updateProgress(data: { currentTime: number; duration: number; percentage: number }) {
        if (elements.progressFill) {
            elements.progressFill.style.width = `${data.percentage}%`;
        }
        if (elements.currentTime) {
            elements.currentTime.textContent = formatTime(data.currentTime);
        }
        if (elements.duration) {
            elements.duration.textContent = formatTime(data.duration);
        }
    }
    
    function formatTime(seconds: number): string {
        if (isNaN(seconds)) return '0:00';
        const mins = Math.floor(seconds / 60);
        const secs = Math.floor(seconds % 60);
        return `${mins}:${secs.toString().padStart(2, '0')}`;
    }
    
    // Bind events
    function bindEvents() {
        // Close player
        controller.bindElement(elements.closeBtn, 'click', () => {
            controller.toggleVisibility();
        });
        
        // Play/Pause
        controller.bindElement(elements.playBtn, 'click', () => {
            controller.togglePlay();
        });
        
        // Previous
        controller.bindElement(elements.prevBtn, 'click', () => {
            controller.previousTrack();
        });
        
        // Next
        controller.bindElement(elements.nextBtn, 'click', () => {
            controller.nextTrack();
        });
        
        // Mute
        controller.bindElement(elements.muteBtn, 'click', () => {
            controller.toggleMute();
        });
        
        // Volume
        controller.bindElement(elements.volumeSlider, 'input', (e: Event) => {
            const value = parseInt((e.target as HTMLInputElement).value);
            controller.setVolume(value);
        });

        // Queue Toggle
        controller.bindElement(elements.queueToggleBtn, 'click', () => {
            elements.queueDrawer?.classList.toggle('hidden');
        });

        // Clear Queue
        controller.bindElement(elements.clearQueueBtn, 'click', () => {
            controller.clearQueue();
        });
        
        // Progress bar click
        const progressBar = document.querySelector('.progress-bar');
        if (progressBar) {
            progressBar.addEventListener('click', (e: Event) => {
                const rect = (e.currentTarget as HTMLElement).getBoundingClientRect();
                const percentage = ((e as MouseEvent).clientX - rect.left) / rect.width;
                controller.seekTo(percentage);
            });
        }
    }
    
    // Track subscription state
    let isSubscribed = false;
    
    // Subscribe to controller events (only once)
    function subscribe() {
        if (isSubscribed) return;
        controller.on('visibilityChange', updateVisibility);
        controller.on('trackChange', updateTrackInfo);
        controller.on('playStateChange', updatePlayButton);
        controller.on('progress', updateProgress);
        controller.on('volumeChange', updateVolumeIcon);
        controller.on('muteChange', updateVolumeIcon);
        controller.on('playlistChange', renderQueue);
        isSubscribed = true;
    }
    
    function unsubscribe() {
        if (!isSubscribed) return;
        controller.off('visibilityChange', updateVisibility);
        controller.off('trackChange', updateTrackInfo);
        controller.off('playStateChange', updatePlayButton);
        controller.off('progress', updateProgress);
        controller.off('volumeChange', updateVolumeIcon);
        controller.off('muteChange', updateVolumeIcon);
        controller.off('playlistChange', renderQueue);
        isSubscribed = false;
    }
    
    // Restore state
    function restore() {
        const state = controller.getState();
        
        if (state.volume !== undefined && elements.volumeSlider) {
            elements.volumeSlider.value = state.volume.toString();
        }
        
        updateVisibility(state.isVisible);
        updateTrackInfo(state.currentTrack);
        updatePlayButton(state.isPlaying);
        updateVolumeIcon();
        renderQueue(state.currentPlaylist);
        
        // Restore progress bar immediately
        if (state.currentTrack && state.duration > 0) {
            updateProgress({
                currentTime: state.currentTime,
                duration: state.duration,
                percentage: (state.currentTime / state.duration) * 100
            });
        }
        
        // Setup audio element - but don't reload if already playing
        if (elements.audio) {
            controller.setAudioElement(elements.audio);
            
            // Only set src if it's different (avoid reloading)
            const needsReload = !elements.audio.src || 
                                elements.audio.src !== new URL(state.currentTrack?.file || '', window.location.href).href;
            
            if (state.currentTrack?.file && needsReload) {
                elements.audio.src = state.currentTrack.file;
                elements.audio.volume = (state.volume || 70) / 100;
                elements.audio.muted = state.isMuted;
                
                if (state.currentTime > 0) {
                    elements.audio.currentTime = state.currentTime;
                }
                
                if (state.isPlaying) {
                    elements.audio.play().catch(console.error);
                }
            } else if (state.currentTrack?.file) {
                // Just update properties without reloading
                elements.audio.volume = (state.volume || 70) / 100;
                elements.audio.muted = state.isMuted;
            }
        }
    }
    
    // Initialize
    function init(isViewTransition = false) {
        getElements();
        bindEvents();
        subscribe();
        
        // Only load saved state on first load, not on view transitions
        // because the audio element is persisted and maintains its own state
        if (!isViewTransition) {
            loadState();
        }
        
        restore();
    }
    
    // First load
    init(false);
    
    // View transition - don't reload state from storage
    document.addEventListener('astro:after-swap', () => {
        init(true);
    });
    
    // Save state on unload
    window.addEventListener('beforeunload', () => {
        saveState(elements.audio || undefined);
    });
    
    // Expose global functions for external use
    window.playAlbum = (album: any, startIndex?: number) => controller.playAlbum(album, startIndex);
    window.playTrack = (track: Track) => controller.playTrack(track);
    window.addToQueue = (track: Track) => controller.addToQueue(track);
    window.playFromQueue = (index: number) => controller.playFromQueue(index);
    window.removeFromQueue = (index: number) => controller.removeFromQueue(index);
    window.playTrackFromBox = (albumId: string, songTitle: string) => {
        const albums = (window as any).__MUSIC_ALBUMS__;
        if (!albums) return;
        
        const album = albums.find((a: any) => a.id === albumId);
        if (!album) return;
        
        const song = album.songs.find((s: any) => s.title === songTitle);
        if (!song) return;
        
        controller.playTrack({
            ...song,
            album: album.title,
            artist: album.artist,
            cover: album.cover
        });
    };
</script>
